---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Enterprise MCP Security Platform"
  description="Aran MCP Sentinel is an enterprise-grade security and management platform for Model Context Protocol (MCP) deployments. Discover, monitor, secure, and manage MCP servers with comprehensive tooling, real-time threat detection, and OWASP MCP Top 10 compliance."
>
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="container mx-auto px-4 py-20">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-6xl md:text-8xl font-black mb-6 leading-tight">
          Secure Your<br />MCP Infrastructure
        </h1>
        <p class="text-xl md:text-2xl mb-8 text-primary-light max-w-2xl mx-auto">
          Enterprise-grade security and management platform for Model Context Protocol deployments. Discover, monitor, and protect your MCP servers.
        </p>
        <div class="flex gap-4 justify-center">
          <a 
            href="/docs" 
            class="px-8 py-4 bg-primary text-white font-bold shadow-brutal hover:shadow-brutal-sm transition-all"
          >
            Get Started
          </a>
          <a 
            href="/features" 
            class="px-8 py-4 border-4 border-black font-bold hover:bg-background-alt transition-colors"
          >
            Learn More
          </a>
        </div>
      </div>
    </section>

    <!-- Features Preview -->
    <section class="bg-background-alt py-20">
      <div class="container mx-auto px-4">
        <h2 class="text-4xl font-black text-center mb-12">Key Capabilities</h2>
        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <div class="bg-white border-4 border-black p-6 shadow-brutal">
            <h3 class="text-2xl font-black mb-4">Server Discovery</h3>
            <p class="text-primary-light">
              Automated discovery of MCP endpoints and services across your network infrastructure.
            </p>
          </div>
          <div class="bg-white border-4 border-black p-6 shadow-brutal">
            <h3 class="text-2xl font-black mb-4">Security Testing</h3>
            <p class="text-primary-light">
              Comprehensive security scanning with OWASP MCP Top 10 compliance checking.
            </p>
          </div>
          <div class="bg-white border-4 border-black p-6 shadow-brutal">
            <h3 class="text-2xl font-black mb-4">Real-time Monitoring</h3>
            <p class="text-primary-light">
              Continuous health monitoring with alerting and performance metrics tracking.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="container mx-auto px-4 py-20">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl font-black mb-6">Ready to Get Started?</h2>
        <p class="text-xl mb-8 text-primary-light">
          Deploy Aran MCP Sentinel in minutes and start securing your MCP infrastructure today.
        </p>
        <a 
          href="https://github.com/adhit-r/aran-mcp" 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-4 bg-accent text-white font-bold shadow-brutal hover:shadow-brutal-sm transition-all"
        >
          View on GitHub
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
