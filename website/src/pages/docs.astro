---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Documentation"
  description="Complete documentation for Aran MCP Sentinel including getting started guides, API reference, deployment instructions, architecture documentation, and security best practices. Learn how to deploy, configure, and use the platform."
>
  <Header />
  <main>
    <section class="container mx-auto px-4 py-20">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-black mb-6">Documentation</h1>
        <p class="text-xl text-primary-light mb-12">
          Comprehensive guides and references for using Aran MCP Sentinel.
        </p>

        <div class="grid md:grid-cols-2 gap-6">
          <a 
            href="https://github.com/adhit-r/aran-mcp/wiki/Getting-Started" 
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border-4 border-black p-6 shadow-brutal hover:shadow-brutal-sm transition-all block"
          >
            <h2 class="text-2xl font-black mb-3">Getting Started</h2>
            <p class="text-primary-light">
              Installation and setup guide for Aran MCP Sentinel.
            </p>
          </a>

          <a 
            href="https://github.com/adhit-r/aran-mcp/wiki/API-Reference" 
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border-4 border-black p-6 shadow-brutal hover:shadow-brutal-sm transition-all block"
          >
            <h2 class="text-2xl font-black mb-3">API Reference</h2>
            <p class="text-primary-light">
              Complete API documentation for all endpoints.
            </p>
          </a>

          <a 
            href="https://github.com/adhit-r/aran-mcp/wiki/Architecture-Overview" 
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border-4 border-black p-6 shadow-brutal hover:shadow-brutal-sm transition-all block"
          >
            <h2 class="text-2xl font-black mb-3">Architecture</h2>
            <p class="text-primary-light">
              System architecture and design documentation.
            </p>
          </a>

          <a 
            href="https://github.com/adhit-r/aran-mcp/wiki/Deployment-Guide" 
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border-4 border-black p-6 shadow-brutal hover:shadow-brutal-sm transition-all block"
          >
            <h2 class="text-2xl font-black mb-3">Deployment Guide</h2>
            <p class="text-primary-light">
              Production deployment instructions and best practices.
            </p>
          </a>

          <a 
            href="https://github.com/adhit-r/aran-mcp/wiki/Contributing" 
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border-4 border-black p-6 shadow-brutal hover:shadow-brutal-sm transition-all block"
          >
            <h2 class="text-2xl font-black mb-3">Contributing</h2>
            <p class="text-primary-light">
              Guidelines for contributing to the project.
            </p>
          </a>

          <a 
            href="https://github.com/adhit-r/aran-mcp/wiki/FAQ" 
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border-4 border-black p-6 shadow-brutal hover:shadow-brutal-sm transition-all block"
          >
            <h2 class="text-2xl font-black mb-3">FAQ</h2>
            <p class="text-primary-light">
              Frequently asked questions and answers.
            </p>
          </a>
        </div>

        <div class="mt-12 bg-background-alt border-4 border-black p-8">
          <h2 class="text-2xl font-black mb-4">Additional Resources</h2>
          <ul class="space-y-2">
            <li>
              <a href="https://github.com/adhit-r/aran-mcp" class="text-accent hover:underline font-semibold" target="_blank" rel="noopener noreferrer">
                GitHub Repository
              </a>
            </li>
            <li>
              <a href="https://github.com/adhit-r/aran-mcp/issues" class="text-accent hover:underline font-semibold" target="_blank" rel="noopener noreferrer">
                Issue Tracker
              </a>
            </li>
            <li>
              <a href="https://github.com/adhit-r/aran-mcp/blob/main/README.md" class="text-accent hover:underline font-semibold" target="_blank" rel="noopener noreferrer">
                README
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

