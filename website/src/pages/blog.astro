---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const posts = [
  {
    title: "Introducing Aran MCP Sentinel",
    date: "2024-12-04",
    excerpt: "Announcing the launch of Aran MCP Sentinel, an enterprise-grade security platform for Model Context Protocol deployments.",
    slug: "introducing-aran-mcp-sentinel"
  },
  {
    title: "OWASP MCP Top 10 Security Risks",
    date: "2024-12-01",
    excerpt: "Understanding the top 10 security risks in Model Context Protocol implementations and how to mitigate them.",
    slug: "owasp-mcp-top-10"
  },
  {
    title: "Best Practices for MCP Server Deployment",
    date: "2024-11-28",
    excerpt: "Learn the best practices for deploying and managing MCP servers in production environments.",
    slug: "mcp-server-deployment"
  }
];
---

<BaseLayout 
  title="Blog"
  description="Latest news, updates, and articles about Aran MCP Sentinel and Model Context Protocol security. Stay informed about MCP security best practices, platform updates, and industry insights."
>
  <Header />
  <main>
    <section class="container mx-auto px-4 py-20">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-black mb-6">Blog</h1>
        <p class="text-xl text-primary-light mb-12">
          Latest updates, articles, and insights about MCP security and management.
        </p>

        <div class="space-y-8">
          {posts.map((post) => (
            <article class="bg-white border-4 border-black p-8 shadow-brutal">
              <time class="text-sm text-primary-light mb-2 block">
                {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="text-3xl font-black mb-4">
                <a href={`/blog/${post.slug}`} class="hover:underline">
                  {post.title}
                </a>
              </h2>
              <p class="text-primary-light mb-4">
                {post.excerpt}
              </p>
              <a 
                href={`/blog/${post.slug}`} 
                class="text-accent font-bold hover:underline"
              >
                Read more →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

